      "dot": "cyan",
      "title": "Instance start (once)",
      "items": [
        "lifespan loads the pinned model before traffic",
        "Startup probe on /ready holds requests until then",
        "Never latest: a floating alias is refused"
      ]
    },
    {
      "dot": "rose",
      "title": "Every request",
      "items": [
