# Copy to airflow/.env (gitignored) and fill in. Required values have no default.

# --- Secrets (required) -------------------------------------------------------
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Fernet keys are url-safe base64 of 32 bytes:
#   openssl rand -base64 32 | tr '+/' '-_'
AIRFLOW_FERNET_KEY=

# --- Host ---------------------------------------------------------------------
# Linux: set to $(id -u) so the containers can write the bind-mounted data dir.
AIRFLOW_UID=50000
# Host dir mounted at /opt/airflow/data (relative to airflow/). Expects raw
# CSVs in raw/x5 (scripts/fetch_x5.sh).
UPLIFT_DATA_HOST_DIR=../data
# UI/API port, bound to 127.0.0.1 only.
AIRFLOW_PORT=8080

# --- Concurrency --------------------------------------------------------------
# Feature shards; the Airflow Variable uplift_num_shards overrides this.
UPLIFT_NUM_SHARDS=8
# Shards running at once, and total task processes for the LocalExecutor.
UPLIFT_MAX_PARALLEL_SHARDS=8
AIRFLOW_PARALLELISM=8
# DuckDB threads per shard.
UPLIFT_SHARD_THREADS=2

# --- MLflow -------------------------------------------------------------------
# Empty: a SQLite store on the data volume.
MLFLOW_TRACKING_URI=
MLFLOW_EXPERIMENT=uplift
# Identity token for an IAM-protected server: gcloud auth print-identity-token
# It expires after one hour. On a GCE VM leave it empty: the train task mints
# a fresh one from the VM's service account through the metadata server.
MLFLOW_TRACKING_TOKEN=
